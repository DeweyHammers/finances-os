# dependencies
node_modules

# next.js
.next
next-env.d.ts
*.tsbuildinfo

# build
/app
/dist
# Android (Phase C): the renderer's export for Capacitor (capacitor.config.ts →
# webDir), the signed APKs, and the release keystore — which must NEVER be
# committed (it lives in the repo's Actions secrets; see docs/android-release.md).
/app-android
/dist-android
*.jks
*.keystore
# The sql.js wasm that scripts/android/browser-check.mjs copies in for the
# in-browser check of the phone data path; never part of a build from a clean clone.
/renderer/public/assets/sql-wasm.wasm

# database
/generated/prisma
*.db
*.db-journal
*.sqlite
*.sqlite-journal
/prisma/dev.db
/prisma/dev.db-journal
# Timestamped auto-backups from db:pull / db:push (scripts/db-sync.cjs) —
# kept on disk as rollback insurance, never committed.
/prisma/*.db.*.bak
# Ad-hoc debugging snapshots (readable state captures paired with .bak files).
# Same rationale: local rollback aid, not source-controlled artifact.
/prisma/*.snapshot.*

# claude
.claude

# archived
_archived


# Lock-in tests run on REAL personal finance data (bill names, costs, balances)
# derived from the DEV database → LOCAL ONLY, never pushed (the repo is public).
# They still run locally and in the pre-push hook; fresh clones simply don't
# have them. See CLAUDE.md → "Lock-in tests".
/tests/fixtures/
/tests/helpers/refine-fixture-mock.ts
*.lockin.test.ts
*.lockin.test.tsx
**/__snapshots__/*.lockin.test.*.snap

# Demo tour tooling (scripts/demo/): the empty-app smoke test's screenshots are
# scratch output. The tour's own screenshots live in docs/img/tour/ and ARE
# committed (all made-up data). prisma/demo.db is covered by `*.db` above.
/scripts/demo/out/

# Sync (Phase B, plans/phone-app-and-sync.md): the device's cloud URL + encrypted
# token, and the embedded replica of the cloud database with libsql's side
# files. Both live beside the database (prisma/ in dev) and never belong in git.
/prisma/sync.json
/prisma/replica.db*
